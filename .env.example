# =============================================================
# 复制本文件为 .env 后修改。真实 .env 绝不提交到 Git。
# 命名规则: 敏感值用随机强密码; 端口冲突时只改端口段。
# =============================================================

# ---------- Zabbix 数据库 ----------
POSTGRES_USER=zabbix
POSTGRES_DB=zabbix
# 必填! 改成你自己的强密码 (不要带 $ # 等特殊字符, 避免 compose 转义问题)
ZABBIX_DB_PASSWORD=ChangeMe_Strong_Pwd_123

# ---------- 对外端口 ----------
# Zabbix Web 访问端口: http://<Ubuntu_IP>:8080
ZABBIX_WEB_PORT=8080
# FastAPI 后端端口:  http://<Ubuntu_IP>:8000
BACKEND_PORT=8000

# ---------- 后端应用 ----------
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/app.db

# ---------- Phase 2: 宿主机原生 agent (不是容器) ----------
# zabbix-server 10051 对外映射端口 (宿主机 agent2 的 Active check 走 宿主机IP:该端口)
ZBX_SERVER_PORT=10051
# 宿主机 agent2 的 Hostname, 必须与 Web UI 里新主机的 Host name 一字不差
HOST_AGENT_NAME=ubuntu-host

# ---------- Phase 5: Zabbix API ----------
# ZABBIX_PASSWORD = 你在 Web 界面改过后的 Admin 登录密码。
# 只填在 Ubuntu 侧 /opt/zops/.env, 绝不提交/不 scp/不贴到聊天里。
# 留空时 backend 照常启动, 但 /api/v1/zabbix/* 与 /problems/sync 返回 502。
ZABBIX_API_URL=http://zabbix-web:8080/api_jsonrpc.php
ZABBIX_USERNAME=Admin
ZABBIX_PASSWORD=
# 后台归档: 每 60 秒同步一次, 回溯 30 天内的真实事件
ZABBIX_SYNC_INTERVAL=60
ZABBIX_SYNC_DAYS=30

# ---------- Phase 9: LLM (OpenAI 兼容协议, 供应商随便换) ----------
# 三要素填在 Ubuntu 侧 /opt/zops/.env; Key 绝不进 Git/聊天/scp。
# 留空时 backend 照常启动, 但 /api/v1/ai/check 与 /analyze 返回 502。
# 可选供应商 (base_url 一律填到 /v1 为止):
#   DeepSeek:  LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   通义千问:  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   Kimi:      LLM_BASE_URL=https://api.moonshot.cn/v1         LLM_MODEL=moonshot-v1-8k
#   智谱:      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4 LLM_MODEL=glm-4-plus
#   自建 Ollama: LLM_BASE_URL=http://<宿主IP>:11434/v1         LLM_MODEL=qwen2.5 (Key 随便填非空)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 大模型响应慢是常态 (推理模型 30s+), 超时默认 120 秒
LLM_TIMEOUT=120
# Phase 10: Agent 自主取证的最大工具轮数 (1-20, 超限中止并归档 FAILED)
LLM_AGENT_MAX_ROUNDS=6

# ---------- Phase 12: AI 自动故障分析调度 ----------
# ACTIVE 告警归档后自动跑带工具取证的分析 (trigger_source=AUTO 落库)。
# 关掉开关只需 AI_AUTO_ENABLED=false 后 docker compose -p zops up -d backend。
AI_AUTO_ENABLED=true
# 扫描周期秒 (30-3600): 分析一次本身就要 30-90s, 再快没有意义
AI_AUTO_INTERVAL=60
# 单轮最多自动分析几条 (1-10): 防告警风暴把 LLM 额度烧穿
AI_AUTO_MAX_PER_TICK=3

# ---------- Phase 13: 人工确认 + 安全执行 ----------
# 闭环: 自动分析 SUCCESS → 操作目录匹配生成"待审批"执行建议
#       → 人 POST /exec/requests/{id}/approve → 白名单动作才真正执行。
# AI 侧零执行路径 (工具白名单恒只读); 执行只认代码里写死的操作目录。
EXEC_ENABLED=true
# 自动分析成功后是否自动生成待审批建议 (false=只留人工创建入口)
EXEC_AUTO_SUGGEST=true
# 可操作容器名白名单 (逗号分隔)。默认只授权演练容器; 留空=全部不可执行。
# 注意: 千万别把 zops-postgres/zops-zabbix-*/zops-backend 加进来。
EXEC_ALLOW_TARGETS=zops-drill
# Docker Engine API socket (compose 已挂载同路径; 删掉挂载行=物理拔通道)
EXEC_DOCKER_SOCKET=/var/run/docker.sock
# 单次 Docker API 超时秒 (5-300)
EXEC_TIMEOUT=30
# 宿主机 docker 组的数字 GID, 注入给 backend 容器做附属组 (镜像内是
# 非 root 的 zops 用户, 没有它连不上 docker.sock)。Ubuntu 上取法:
#   echo "DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)" >> .env
DOCKER_GID=999

# ---------- Phase 14: 审计日志 ----------
# 关键动作 (AI 分析/执行审批/调度轮次/进程启动) 全部写入 audit_events,
# 每行 sha256 签名 + 前向链, GET /api/v1/audit/verify 可全量重放防篡改。
# false 只停止"新写入", 查询/校验接口照常 —— 关审计不等于毁审计。
AUDIT_ENABLED=true
